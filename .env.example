NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Solo servidor: no agregar NEXT_PUBLIC_ a estas variables.
RESEND_API_KEY=re_tu_clave_de_resend
RESEND_FROM_EMAIL="Mensaje al Alma <hola@tu-dominio-verificado.com>"
APP_URL=http://localhost:3000

# Operaciones privilegiadas: SOLO servidor; nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_del_mismo_proyecto
# Generá al menos 32 caracteres aleatorios. Conservála: rotarla invalida enlaces previos.
RECIPIENT_TOKEN_SECRET=tu_secreto_aleatorio_de_al_menos_32_caracteres
RESEND_WEBHOOK_SECRET=whsec_tu_secreto_de_firma
# Opcional: protege el mantenimiento de huérfanos; no agregar NEXT_PUBLIC_.
CRON_SECRET=tu_secreto_aleatorio_de_mantenimiento
